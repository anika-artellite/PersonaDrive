# PersonaDrive environment variables
# Copy to `.env`, edit the values for your machine, then load it before running
# anything:
#     cp .env.example .env
#     set -a; source .env; set +a
#
# `.env` / `.env.*` are gitignored. Every variable has a fallback in the code;
# the fallbacks are `/path/to/...` placeholders or paths relative to
# PERSONADRIVE_ROOT, so set at least PERSONADRIVE_ROOT and PERSONADRIVE_DATA_ROOT.

# === Repository ======================================================
# Absolute path to this checkout. Most other defaults derive from it.
PERSONADRIVE_ROOT=/path/to/PersonaDrive

# === CARLA ===========================================================
# CARLA 0.9.15 root (the directory containing CarlaUE4.sh).
# Default in code: ${PERSONADRIVE_ROOT}/software/carla0915
CARLA_ROOT=/path/to/carla0915
# Standard CARLA / leaderboard variables (also exported by the eval scripts).
WORK_DIR=${PERSONADRIVE_ROOT}
SCENARIO_RUNNER_ROOT=${PERSONADRIVE_ROOT}/scenario_runner
LEADERBOARD_ROOT=${PERSONADRIVE_ROOT}/leaderboard

# === Data ============================================================
# Dataset root: the directory that CONTAINS `simlingo/` (see datasets/README.md).
# Colon-separated list allowed; entries are searched in order. Used to resolve
# the absolute frame paths stored in FAISS metadata and icl_examples.json.gz.
# Default in code: ${PERSONADRIVE_ROOT}/database
PERSONADRIVE_DATA_ROOT=/path/to/database
# Glob of training shards used by simlingo_training/config.py when an experiment
# yaml does not set data_path (all shipped experiments set it).
PERSONADRIVE_TRAIN_DATA_GLOB=

# === Hugging Face cache =============================================
# cache_dir for SigLIP / InternVL2 / BGE-M3 downloads (a shared dir is recommended on
# clusters). Empty: Hugging Face's default cache ($HF_HOME, else ~/.cache/huggingface).
PERSONADRIVE_HF_CACHE=

# === Conda environments (environment/README.md) =====================
# The PersonaDrive env (environment/setup_env.sh -n personadrive); activated by
# the SLURM scripts and the smoke test.
PERSONADRIVE_CONDA_ENV=/path/to/conda/envs/personadrive

# === Retrieval (Stage 1-2 artefacts) ================================
# Root holding checkpoints/, embeddings*/, triplets*/ and faiss_index/<profile>/.
# Default in code: ${PERSONADRIVE_ROOT}/persona_drive_rag
PERSONADRIVE_ICL_ROOT=
# Retrieval-head checkpoint. Default: ${PERSONADRIVE_ICL_ROOT}/checkpoints/best_model.pt
PERSONADRIVE_ICL_CKPT=
# Index the closed-loop agent queries:
#   normal  = style-agnostic PDM-lite index (no-style experiment; code default)
#   default = human neutral | fast = human/expert aggressive | slow = conservative
PERSONADRIVE_ICL_PROFILE=normal
# Number of retrieved context points K at evaluation (unset = training config, 2;
# 0 disables retrieval).
PERSONADRIVE_NUM_ICL=

# === Evaluation ======================================================
# Stage-3 checkpoint to evaluate: the released single file, or the last.ckpt
# DeepSpeed dir of your own run. Its run's .hydra/ must be an ancestor sibling,
# as in a hydra output dir.
# Default: ${PERSONADRIVE_ROOT}/pretrained/personadrive_icl_sft/checkpoints/epoch=000.ckpt/pytorch_model.pt
#          (where README step 1 downloads the released model)
PERSONADRIVE_CKPT=
# Where results are written. Default: ${PERSONADRIVE_ROOT}/eval_results/single_route
PERSONADRIVE_EVAL_OUT_ROOT=
# Bench2Drive route XMLs. Default: ${PERSONADRIVE_ROOT}/leaderboard/data/bench2drive_split
PERSONADRIVE_ROUTE_PATH=
# Comma-separated profiles for scripts/eval/start_eval_simlingo.py (default in file: slow).
PERSONADRIVE_PROFILES=
# Suffix for progress/assignment files (default derived from the profile list).
PERSONADRIVE_RUN_TAG=
# 1 = agent writes debug PNGs/telemetry; HD_VIZ = high-resolution overlays.
PERSONADRIVE_AGENT_DEBUG=0
PERSONADRIVE_AGENT_HD_VIZ=0

# === SLURM (only for the cluster launchers) =========================
PERSONADRIVE_SLURM_ACCOUNT=
PERSONADRIVE_SLURM_ACCOUNT_GPU=
PERSONADRIVE_SLURM_ACCOUNT_GPU32=
# Comma-separated nodes to avoid.
PERSONADRIVE_SLURM_EXCLUDE=

# === Dataset packaging (datasets/package_datasets.sh) ===============
PERSONADRIVE_RELEASE_DIR=
